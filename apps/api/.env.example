# Environment
NODE_ENV=development
PORT=5000

# PostgreSQL Connection (Supabase compatible)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/seait_voting?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/seait_voting?schema=public"

# Authentication & Encryption Secrets
JWT_SECRET="replace-with-a-secure-random-32-byte-hex-secret-in-production"
JWT_EXPIRES_IN="8h"
ENCRYPTION_KEY="replace-with-a-secure-64-character-hex-aes-key-in-production"

# Frontend Origin for CORS
FRONTEND_ORIGIN="http://localhost:3000"

# Blockchain EVM Integration (Hardhat local / testnet)
BLOCKCHAIN_RPC_URL="http://127.0.0.1:8545"
BLOCKCHAIN_CHAIN_ID=31337
BLOCKCHAIN_CONTRACT_ADDRESS="0x5FbDB2315678afecb367f032d93F642f64180aa3"
BLOCKCHAIN_DEPLOYER_PRIVATE_KEY=""
