{
  "name": "seait-voting-system",
  "version": "1.0.0",
  "private": true,
  "description": "Online Voting Management System with Blockchain for South East Asian Institute of Technology, Inc. (SEAIT)",
  "workspaces": [
    "apps/*",
    "blockchain"
  ],
  "scripts": {
    "dev:web": "npm --workspace=apps/web run dev",
    "dev:api": "npm --workspace=apps/api run dev",
    "build": "npm --workspace=apps/api run build",
    "build:all": "npm run build --workspaces --if-present",
    "build:web": "npm --workspace=apps/web run build",
    "build:api": "npm --workspace=apps/api run build",
    "start": "npm --workspace=apps/api run start",
    "start:web": "npm --workspace=apps/web run start",
    "start:api": "npm --workspace=apps/api run start",
    "test": "npm run test --workspaces --if-present",
    "test:api": "npm --workspace=apps/api run test",
    "test:blockchain": "npm --workspace=blockchain run test",
    "db:generate": "npm --workspace=apps/api run db:generate",
    "db:push": "npm --workspace=apps/api run db:push",
    "db:seed": "npm --workspace=apps/api run db:seed"
  },
  "keywords": [
    "voting",
    "blockchain",
    "seait",
    "election",
    "solidity",
    "nextjs",
    "express",
    "postgresql",
    "prisma"
  ],
  "author": "South East Asian Institute of Technology, Inc. (SEAIT) CICT",
  "license": "ISC"
}
